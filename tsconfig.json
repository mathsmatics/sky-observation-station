{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "outDir": ".build/ts",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "removeComments": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "src/globals.d.ts"],
  "exclude": ["assets", "vendor", ".build", "node_modules"]
}
