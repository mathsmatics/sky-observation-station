{
  "name": "sky-observation-station",
  "version": "5.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('assets',{recursive:true,force:true});fs.mkdirSync('assets',{recursive:true});fs.copyFileSync('src/styles.css','assets/app.css')\" && esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=assets/app.js --log-level=info",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}


